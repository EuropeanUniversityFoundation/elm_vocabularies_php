msgid "Learning schedule type"
msgstr "An cineál sceidil foghlama"

msgid "Part time light"
msgstr "Sceideal éadrom páirtaimseartha"

msgid "Part time light (less than 8 hours)"
msgstr "Sceideal éadrom páirtaimseartha (níos lú ná 8 uair an chloig)"

msgid "Full time "
msgstr "Lánaimseartha"

