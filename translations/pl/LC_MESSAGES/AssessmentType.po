# ELM Assessment type vocabulary in Polish.
msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pl\n"

msgid "Assessment type"
msgstr "Typ oceny"

msgid "peer assessment"
msgstr "Wzajemna ocena"

msgid "Peers grade you."
msgstr "Oceniają pozostali uczestnicy zajęć."

msgid "marked assignment"
msgstr "Ocena zadania"

msgid "continuous evaluation"
msgstr "Ocena na podstawie pracy przez cały okres nauki"

msgid "portfolio"
msgstr "Portfolio"

msgid "group performance"
msgstr "Realizacja zadania grupowego"

msgid "practical assessment"
msgstr "Ocena umiejętności praktycznych"

msgid "written examination"
msgstr "Egzamin pisemny"

msgid "level of attendance"
msgstr "Poziom obecności"

msgid "project work"
msgstr "Przygotowanie projektów"

msgid "peer review"
msgstr "Wzajemna weryfikacja"

msgid "test of presentation and/or synthesis skills"
msgstr "Test umiejętności w zakresie prezentacji lub syntezy informacji. Komentują pozostali uczestnicy zajęć, ale to nauczyciel wystawia ocenę."

msgid "quiz"
msgstr "Kwiz"

msgid "problem based learning"
msgstr "Uczenie się oparte na rozwiązaniu problemu"

msgid "oral examination"
msgstr "Egzamin ustny"

msgid "artefact assessment"
msgstr "Ocena artefaktów"

msgid "Presentation"
msgstr "Prezentacja"
